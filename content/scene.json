{
  "background": {
    "comment": "全站 3D 背景（浑天仪圆环、等高线山川、粒子）的可调参数。透明度与层级在 src/styles/00-tokens.css。",
    "quality": {
      "high": { "pixelRatioCap": 1.5, "fps": 60 },
      "low": { "pixelRatioCap": 1, "fps": 30 },
      "reducedMotion": { "pixelRatioCap": 1, "fps": 0, "note": "只渲染静帧；滚动到新板块时重绘一次" }
    },
    "lightTheme": {
      "lineColor": "#2f6b78",
      "lineOpacityBoost": 2.6,
      "ringColor": "#9a6a1c",
      "ringOpacityBoost": 2.2,
      "particleColor": "#3a7684",
      "particleOpacityBoost": 1.8,
      "fog": "#efe9dc"
    },
    "darkTheme": {
      "lineOpacityBoost": 1.25,
      "ringOpacityBoost": 1.2,
      "particleOpacityBoost": 1.15
    },
    "scroll": {
      "cameraTravelY": 5.2,
      "cameraTravelZ": 3.4,
      "ringSpinPerSection": 0.55,
      "parallaxNear": 1.0,
      "parallaxFar": 0.35
    },
    "sections": {
